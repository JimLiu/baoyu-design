    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "motion",
    "animation",
    "video"
  ],
  "homepage": "https://github.com/JimLiu/baoyu-design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JimLiu/baoyu-design.git",
    "directory": "dsh-plugins/dsh-claude-motion"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jim Liu 宝玉",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "docs",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "dependencies": {
    "dsh-claude-artifacts": "^2.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
